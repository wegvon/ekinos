{
  "name": "freefocusgames",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "generate-i18n": "node scripts/build-i18n-compiled.js",
    "generate-blog": "node build-scripts/generate-blog-data.js",
    "verify:sudoku": "node build-scripts/verify-sudoku-unique.js all 10",
    "seo:gsc": "node build-scripts/gsc-keywords.js",
    "build": "npm run generate-i18n && npm run generate-blog && next build && npm run build:server",
    "start": "NODE_ENV=production node dist/server.js",
    "lint": "next lint",
    "translate-blogs": "node scripts/translate-blog-posts.js",
    "translate-blogs:force": "node scripts/translate-blog-posts.js --force",
    "seo:audit": "node build-scripts/seo/audit.mjs",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server.ts scripts/hesap-sifre-sifirla.ts --bundle --platform=node --target=node22 --format=cjs --packages=external --outdir=dist --entry-names=[name] --tsconfig=tsconfig.json",
    "test": "vitest run",
    "hesap:sifre-sifirla": "tsx scripts/hesap-sifre-sifirla.ts"
  },
  "dependencies": {
    "@google/genai": "^1.38.0",
